{
  "appId": "com.parking3d.jeux",
  "appName": "Parking 3D",
  "webDir": "www",
  "backgroundColor": "#0b1220",
  "android": {
    "backgroundColor": "#0b1220",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchShowDuration": 4000,
      "backgroundColor": "#0b1220",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#0b1220"
    }
  }
}
